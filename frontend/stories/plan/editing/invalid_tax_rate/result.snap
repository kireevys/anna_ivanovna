                type: envelope
                value:
                  MONEY:
                    value:
                      value: "30000"
                      currency: RUB
              category: ~
      edit:
        incomes:
          - name: Зарплата
            kind: Other
            amount: "100000"
            tax_rate: "13"
        expenses:
          - name: Аренда
            category: ~
